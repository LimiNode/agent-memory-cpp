{
  "schema_version": 1,
  "oracle_name": "persistent_lexical_index_v1",
  "identity": {
    "scope_id": "scope:default",
    "projection_kind": "Original",
    "tokenizer_fingerprint": "code_aware_fixture_v1",
    "normalization_fingerprint": "unicode_casefold_v1",
    "statistics_epoch": "epoch:E1",
    "statistics_generation": 11,
    "posting_layout_version": 1
  },
  "tie_policy": "score descending, unit_id ascending",
  "shared_scorer_inputs": {
    "k1": 1.5,
    "b": 0.75,
    "idf": "log1p_okapi",
    "documents": [
      {"unit_id": "u_short", "document_unit": "chunk", "resource_id": "r1", "resource_generation": 4, "projection_version": "p1", "length": 1, "terms": {"alpha": 1}},
      {"unit_id": "u_long", "document_unit": "chunk", "resource_id": "r1", "resource_generation": 4, "projection_version": "p1", "length": 7, "terms": {"alpha": 1, "beta": 6}},
      {"unit_id": "u_resource", "document_unit": "resource", "resource_id": "r2", "resource_generation": 2, "projection_version": "p3", "length": 3, "terms": {"alpha": 2}}
    ],
    "collection": {"unit_count": 3, "total_token_count": 11, "average_length": 3.6666666666666665},
    "document_frequency": {"alpha": 3, "beta": 1}
  },
  "ranking_cases": [
    {
      "name": "alpha_length_competition",
      "query_terms": ["alpha"],
      "expected": {
        "bm25": ["u_resource", "u_short", "u_long"],
        "bm25_plus": ["u_resource", "u_short", "u_long"],
        "bm25l": ["u_resource", "u_short", "u_long"]
      }
    },
    {
      "name": "tie_break_after_equal_score",
      "documents": [
        {"unit_id": "a", "length": 2, "terms": {"alpha": 1}},
        {"unit_id": "b", "length": 2, "terms": {"alpha": 1}}
      ],
      "collection": {"unit_count": 2, "total_token_count": 4, "average_length": 2.0},
      "document_frequency": {"alpha": 2},
      "query_terms": ["alpha"],
      "expected": {"bm25": ["a", "b"], "bm25_plus": ["a", "b"], "bm25l": ["a", "b"]}
    }
  ],
  "snapshot_cases": [
    {"name": "same_epoch_complete_overlay", "base_generation": 10, "target_generation": 11, "adds": ["u_new"], "removes": ["u_long"], "replacements": [], "expected_outcome": "exact"},
    {"name": "same_epoch_incomplete_overlay", "base_generation": 10, "target_generation": 11, "adds": ["u_new"], "removes": [], "replacements": [], "missing_delta": "remove:u_long", "expected_outcome": "unavailable"},
    {"name": "epoch_mismatch", "base_epoch": "epoch:E0", "target_epoch": "epoch:E1", "expected_outcome": "unavailable"},
    {"name": "projection_version_mismatch", "posting_projection_version": "p2", "active_projection_version": "p3", "expected_outcome": "filtered"},
    {"name": "resource_generation_mismatch", "posting_resource_generation": 1, "active_resource_generation": 2, "expected_outcome": "filtered"}
  ],
  "acceleration_cases": [
    {"name": "matching_bm25_block_bounds", "scorer": "bm25", "statistics_generation": 11, "expected_outcome": "exact"},
    {"name": "bm25_bounds_used_for_bm25l", "scorer": "bm25l", "statistics_generation": 11, "bound_scorer": "bm25", "expected_outcome": "disable_pruning"},
    {"name": "generation_bound_mismatch", "scorer": "bm25", "statistics_generation": 10, "active_generation": 11, "expected_outcome": "disable_pruning"}
  ]
}
