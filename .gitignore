build*/
tmp/
.claude/
.vs/
.vscode/
*.user
*.suo
*.log
*.pyc
__pycache__/
CMakeUserPresets.json
.omc/
# Frozen finalist payloads are local materialization artifacts; receipt/raw
# bind their exact paths, sizes and SHA-256 values without tracking large blobs.
finalist-v1/*.i4
finalist-v1/*.i8
finalist-v1/*.f32
finalist-v1/*.u8
# Learned-codec research payloads are externalized and SHA-bound by an
# experiment manifest; keep compact JSON receipts/audits in Git.
artifacts/lsq*-*/*.npz
artifacts/plsq*-*/*.npz
